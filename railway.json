{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "./start.sh",
    "restartPolicyType": "ON_FAILURE",
    "restartMaxRetries": 3,
    "volumes": [
      {
        "mountPath": "/app/data"
      },
      {
        "mountPath": "/app/storage"
      }
    ],
    "healthcheckPath": "/",
    "healthcheckTimeout": 100
  }
}
