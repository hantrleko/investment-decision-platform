generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  // "admin" | "analyst" | "viewer". Existing single-user installs default to
  // admin so behavior is unchanged. Multi-user installs can create scoped roles.
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  researchArtifacts ResearchArtifact[]
  decisions         Decision[]
  recommendations   Recommendation[]
  apiTokens         ApiToken[]
}

// Personal access token for the read-only public API (/api/v1/*).
// Only a SHA-256 hash of the token is stored; the plaintext is shown once.
model ApiToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  // Space-separated scopes, e.g. "read:assets read:decisions".
  scopes     String    @default("read")
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Asset {
  ticker        String   @id
  name          String
  sector        String?
  assetType     String   @default("equity")
  exchange      String?
  notes         String?
  lastPrice     Float?
  lastPriceTs   DateTime?
  priceSource   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  researchArtifacts ResearchArtifact[]
  scores           Score[]
  watchlistEntries WatchlistEntry[]
  recommendations  Recommendation[]
  alerts           Alert[]
}

model Framework {
  id               String  @id @default(cuid())
  name             String  @unique
  slug             String  @unique
  description      String?
  schemaDefinition String
  isActive         Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  scores Score[]
}

model ResearchArtifact {
  id          String   @id @default(cuid())
  title       String
  content     String
  contentType String   @default("rich-text")
  tags        String   @default("")
  assetTicker String?
  asset       Asset?   @relation(fields: [assetTicker], references: [ticker], onDelete: SetNull)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments DocumentAttachment[]
  scores      Score[]
  decisions   DecisionResearchLink[]

  @@index([assetTicker])
  @@index([createdAt])
}

model DocumentAttachment {
  id                  String   @id @default(cuid())
  fileName            String
  filePath            String
  mimeType            String
  fileSizeBytes       Int
  researchArtifactId  String
  researchArtifact    ResearchArtifact @relation(fields: [researchArtifactId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
}

model Score {
  id                 String    @id @default(cuid())
  frameworkId        String
  framework          Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  assetTicker        String
  asset              Asset     @relation(fields: [assetTicker], references: [ticker], onDelete: Cascade)
  researchArtifactId String?
  researchArtifact   ResearchArtifact? @relation(fields: [researchArtifactId], references: [id], onDelete: SetNull)
  factorScores       String
  compositeScore     Float?
  manualOverride     Boolean   @default(false)
  overrideNote       String?
  provenance         String
  scoredAt           DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  decisions DecisionScoreLink[]

  @@index([assetTicker])
  @@index([compositeScore])
  @@index([scoredAt])
}

model Decision {
  id          String   @id @default(cuid())
  title       String
  direction   String
  thesis      String
  status      String   @default("open")
  outcome     String?
  outcomeNote String?
  outcomeDate DateTime?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  researchLinks DecisionResearchLink[]
  scoreLinks    DecisionScoreLink[]

  @@index([status])
  @@index([createdAt])
}

model DecisionResearchLink {
  decisionId         String
  researchArtifactId String
  decision           Decision         @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  researchArtifact   ResearchArtifact @relation(fields: [researchArtifactId], references: [id], onDelete: Cascade)

  @@id([decisionId, researchArtifactId])
}

model DecisionScoreLink {
  decisionId String
  scoreId    String
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  score      Score    @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@id([decisionId, scoreId])
}

model WatchlistEntry {
  id          String   @id @default(cuid())
  assetTicker String
  asset       Asset    @relation(fields: [assetTicker], references: [ticker], onDelete: Cascade)
  notes       String?
  addedAt     DateTime @default(now())
}

model StrategyConfig {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  active      Boolean  @default(true)
  version     String   @default("1.0.0")
  config      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StrategyConfigHistory {
  id              String   @id @default(cuid())
  strategySlug    String
  strategyName    String
  configSnapshot  String
  note            String?
  experimentLabel String?
  createdAt       DateTime @default(now())

  @@index([strategySlug])
}

model Recommendation {
  id              String   @id @default(cuid())
  strategySlug    String
  strategyName    String
  strategyVersion String?
  configSnapshot  String?
  configHistoryId String?
  assetTicker     String
  asset           Asset    @relation(fields: [assetTicker], references: [ticker], onDelete: Cascade)
  recommendation  String
  reasoning       String
  inputSignals    String
  rulesTriggered  String
  scoreIds        String
  researchIds     String
  convertedDecisionId String?
  authorId        String
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([assetTicker])
  @@index([strategySlug])
  @@index([assetTicker, strategySlug])
  @@index([createdAt])
}

// Price / signal alert rule attached to an asset. When the configured
// condition is met (evaluated by the cron job or on price refresh), a
// Notification is generated and the alert's lastTriggeredAt is stamped.
model Alert {
  id           String   @id @default(cuid())
  assetTicker  String
  asset        Asset    @relation(fields: [assetTicker], references: [ticker], onDelete: Cascade)
  // "price_above" | "price_below" | "pct_change"
  kind         String
  // Numeric threshold: absolute price for price_above/below, percent for pct_change
  threshold    Float
  note         String?
  active       Boolean  @default(true)
  // Reference price captured when the alert was created (used by pct_change).
  referencePrice Float?
  lastTriggeredAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notifications Notification[]

  @@index([assetTicker])
  @@index([active])
}

// In-app notification. Generated by alerts, strategy runs, score changes, or
// scheduled jobs. Read/unread state drives the nav bell badge.
model Notification {
  id          String   @id @default(cuid())
  // "alert" | "recommendation" | "score" | "job"
  kind        String
  title       String
  body        String?
  // Optional deep-link into the app (e.g. /assets/AAPL).
  link        String?
  assetTicker String?
  alertId     String?
  alert       Alert?   @relation(fields: [alertId], references: [id], onDelete: SetNull)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([readAt])
  @@index([createdAt])
}
